<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_inicio">

    <fragment
        android:id="@+id/nav_inicio"
        android:name="com.luanpsantanadev.saneam.ui.dashboard.FragmentDashboard"
        android:label="@string/title_inicio"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/nav_inventario"
        android:name="com.luanpsantanadev.saneam.ui.inventario.InventarioFragment"
        android:label="@string/title_inventario"
        tools:layout="@layout/fragment_inventario" />

    <fragment
        android:id="@+id/nav_moviment"
        android:name="com.luanpsantanadev.saneam.ui.movimentacoes.MovimentacoesFragment"
        android:label="@string/title_moviment"
        tools:layout="@layout/fragment_movimentacoes">
        <argument
            android:name="tab_inicial"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/nav_config"
        android:name="com.luanpsantanadev.saneam.ui.config.ConfigFragment"
        android:label="@string/title_config"
        tools:layout="@layout/fragment_configuracoes" />

</navigation>