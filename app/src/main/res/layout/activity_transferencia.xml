<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Top Bar / Back Button & Title -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnBackCard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="#F1F5F9"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Voltar"
                app:srcCompat="@drawable/ic_arrow_left"
                app:tint="#0F172A" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Transferência"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnBackCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBackCard"
            app:layout_constraintTop_toTopOf="@id/btnBackCard" />

        <!-- Header Info Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#EFF6FF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/btnBackCard"
            app:strokeColor="#DBEAFE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="#60A5FA"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/ic_swap_horizontal"
                        app:tint="#FFFFFF" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transferência Interna"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mover material entre depósitos"
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Campo: Material -->
        <TextView
            android:id="@+id/lblMaterial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="MATERIAL"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardHeader" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutMaterial"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#E2E8F0"
            app:endIconDrawable="@drawable/ic_search"
            app:endIconMode="custom"
            app:endIconTint="#94A3B8"
            app:hintEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/lblMaterial">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtMaterial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Selecionar material..."
                android:inputType="text"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Seção: Origem e Destino -->
        <TextView
            android:id="@+id/lblOrigem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="ORIGEM"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/iconArrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inputLayoutMaterial" />

        <TextView
            android:id="@+id/lblDestino"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="DESTINO"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/inputLayoutDestino"
            app:layout_constraintTop_toTopOf="@id/lblOrigem" />

        <!-- Campo: Origem -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutOrigem"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#E2E8F0"
            app:hintEnabled="false"
            app:layout_constraintEnd_toStartOf="@id/iconArrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblOrigem">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtOrigem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Depósito..."
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ícone Seta entre Origem e Destino -->
        <androidx.cardview.widget.CardView
            android:id="@+id/iconArrow"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginHorizontal="8dp"
            app:cardBackgroundColor="#EFF6FF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="@id/inputLayoutOrigem"
            app:layout_constraintEnd_toStartOf="@id/inputLayoutDestino"
            app:layout_constraintStart_toEndOf="@id/inputLayoutOrigem"
            app:layout_constraintTop_toTopOf="@id/inputLayoutOrigem"
            app:strokeWidth="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_arrow_right"
                app:tint="#3B82F6" />
        </androidx.cardview.widget.CardView>

        <!-- Campo: Destino -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayoutDestino"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#E2E8F0"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/iconArrow"
            app:layout_constraintTop_toTopOf="@id/inputLayoutOrigem">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtDestino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Depósito..."
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Seção: Quantidade -->
        <TextView
            android:id="@+id/lblQuantidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="QUANTIDADE"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/inputLayoutOrigem" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardQuantidade"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/lblQuantidade"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageButton
                    android:id="@+id/btnMinus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Diminuir"
                    android:src="@drawable/ic_minus"
                    app:tint="#3B82F6" />

                <TextView
                    android:id="@+id/txtQuantidade"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#64748B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtUnidade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    android:text="un"
                    android:textColor="#64748B"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnPlus"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Aumentar"
                    android:src="@drawable/ic_plus"
                    app:tint="#3B82F6" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botão Confirmar Transferência -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:enabled="false"
            android:text="Confirmar Transferência"
            android:textAllCaps="false"
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#E2E8F0"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/cardQuantidade" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>